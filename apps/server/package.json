{
  "name": "@bizshuffle-bun/server-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/main.ts",
    "build": "bun build src/main.ts --outdir dist --target bun",
    "build:release": "bun build src/main.ts --compile --outfile dist/bizshuffle-server.exe --target bun-windows-x64",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bizshuffle-bun/server-host": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "^6.0.3"
  }
}
